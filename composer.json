{
    "name": "filagora/filagora-messages",
    "description": "Private conversations between members, with folders, read state and trash, for Filagora.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filagora",
        "private-messages"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2.1"
    },
    "require-dev": {
        "filagora/filagora-forums": "^0.6",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Messages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Messages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Messages\\MessagesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filagora/filagora-forums": "Lets private messages carry attachments: adds the link columns to its attachments table, and the rule that only the conversation's participants may see them."
    }
}
